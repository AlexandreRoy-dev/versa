[Unit]
Description=Versa Capital refresh prototype (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/versa-capital
# deploy.sh substitutes the node path it actually found on the host.
ExecStart=__NODE_BIN__ server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=43127
Environment=HOSTNAME=127.0.0.1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=versa-capital

# next/image writes optimised images under .next/cache, so the app directory
# has to stay writable; everything outside it does not.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/versa-capital/.next

[Install]
WantedBy=multi-user.target
